# Production image — no --reload, no dev volumes, runs on whatever PORT the
# host gives us (Cloud Run and App Runner both inject $PORT at runtime).

FROM python:3.12-slim

WORKDIR /app

# build deps for psycopg2 + sentence-transformers / torch wheels
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc g++ curl git \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Pre-download the BioBERT weights into the image so cold starts on Cloud Run
# / App Runner don't pay the HF download tax on every container boot.
RUN python -c "from sentence_transformers import SentenceTransformer; \
    SentenceTransformer('pritamdeka/BioBERT-mnli-snli-scinli-scitail-mednli-stsb')"

COPY . .

# Cloud Run injects $PORT, App Runner uses 8080 by default.
ENV PORT=8080
EXPOSE 8080

CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT}"]
